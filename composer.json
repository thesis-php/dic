{
    "name": "thesis/dic",
    "description": "Thesis DI Container",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Typhoon Team",
            "homepage": "https://github.com/orgs/typhoon-php/people"
        }
    ],
    "require": {
        "php": "^8.4.12",
        "symfony/polyfill-php85": "^1.37",
        "thesis/formatter": "^0.1",
        "typhoon/type": "^0.8.1"
    },
    "require-dev": {
        "amphp/amp": "^3.1",
        "revolt/event-loop": "^1.0",
        "symfony/var-dumper": "^8.1.10",
        "testo/assert": "^0.1.17",
        "testo/codecov": "^0.2.5",
        "testo/data": "^0.1.10",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.56"
    },
    "conflict": {
        "revolt/event-loop": "<1.0 || >=2.0"
    },
    "suggest": {
        "revolt/event-loop": "Lets concurrent fibers share one instance of a service instead of each creating its own"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\": "src/"
        },
        "files": [
            "src/Dic/Autowire.php",
            "src/Dic/DoNotAutowire.php",
            "src/Dic/Internal/caller.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\": "tests/"
        },
        "files": [
            "tests/Fixture/concurrently.php",
            "tests/Fixture/ref.php"
        ]
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
