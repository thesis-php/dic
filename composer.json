{
    "name": "thesis/dic",
    "description": "Thesis DI Container",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Typhoon Team",
            "homepage": "https://github.com/orgs/typhoon-php/people"
        }
    ],
    "require": {
        "php": "^8.4",
        "psr/container": "^2.0",
        "typhoon/formatter": "^0.1@dev",
        "typhoon/type": "^0.8@dev"
    },
    "require-dev": {
        "monolog/monolog": "^3.10",
        "phpunit/phpunit": "^13.0",
        "psr/log": "^3.0",
        "symfony/var-dumper": "^8.0.4"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Project\\": "examples/Project/",
            "Thesis\\": "tests/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
