{
    "name": "thesis/dic",
    "description": "Thesis DI Container",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Typhoon Team",
            "homepage": "https://github.com/orgs/typhoon-php/people"
        }
    ],
    "require": {
        "php": "^8.4",
        "thesis/formatter": "^0.1",
        "typhoon/type": "^0.8.1"
    },
    "require-dev": {
        "symfony/var-dumper": "^8.0.4",
        "testo/testo": "^0.10.2"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\": "src/"
        },
        "files": [
            "src/DIC/doNotAutowire.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\": "tests/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
