includes:
    - tools/phpstan/vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
        - demo.php
    checkBenevolentUnionTypes: true
    ignoreErrors:
        -
            identifier: missingType.generics
    editorUrl: '=>'
    editorUrlTitle: '%%file%%:%%line%%'
    tmpDir: ./var/phpstan
